{
  "name": "wppbot",
  "version": "1.0.0",
  "description": "Bot avançado para WhatsApp que participa de gincanas em grupo respondendo perguntas do líder usando IA (OpenAI/Gemini).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "imports": {
    "#config": "./src/config/index.js",
    "#config/*": "./src/config/*.js",
    "#core/*": "./src/core/*.js",
    "#platform/*": "./src/platform/*.js",
    "#platform/helpers": "./src/platform/helpers.js",
    "#infra/db": "./src/infra/db/index.js",
    "#infra/db/*": "./src/infra/db/*.js",
    "#infra/db/repositories/*": "./src/infra/db/repositories/*.js",
    "#providers/ai": "./src/providers/ai/index.js",
    "#providers/ai/*": "./src/providers/ai/*.js",
    "#providers/ocr": "./src/providers/ocr/index.js",
    "#providers/audio": "./src/providers/audio/index.js",
    "#providers/whatsapp": "./src/providers/whatsapp/index.js",
    "#providers/whatsapp/*": "./src/providers/whatsapp/*.js",
    "#modules/cache": "./src/modules/cache/index.js",
    "#modules/cooldown": "./src/modules/cooldown/index.js",
    "#modules/state": "./src/modules/state/index.js",
    "#modules/stats": "./src/modules/stats/index.js",
    "#modules/history": "./src/modules/history/index.js",
    "#modules/activity": "./src/modules/activity/index.js",
    "#modules/groups": "./src/modules/groups/index.js",
    "#pipeline/*": "./src/pipeline/*.js",
    "#web/*": "./src/web/*.js",
    "#web/routes/*": "./src/web/routes/*.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dashboard:install": "npm install --prefix dashboard",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop wppbot",
    "pm2:logs": "pm2 logs wppbot",
    "pm2:restart": "pm2 restart wppbot"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "openai",
    "gemini",
    "gincana",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "openai": "^6.38.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "^1.34.7"
  }
}
