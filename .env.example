# ============================================================
#  CONFIGURAÇÃO DO BOT DE GINCANA WHATSAPP
# ============================================================
# Copie este arquivo para `.env` e preencha com seus dados:
#   cp .env.example .env
# ============================================================

# ----- Provedor de IA -----
# Escolha "openai" ou "gemini"
AI_PROVIDER=openai

# Chave da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelos baratos recomendados (custo por 1M tok in/out):
#   gpt-4.1-nano  ($0.10 / $0.40)  ← mais barato
#   gpt-4o-mini   ($0.15 / $0.60)  ← bom equilíbrio (default)
OPENAI_MODEL=gpt-4o-mini

# Chave do Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelos válidos (atenção: "gemini-3.5-flash" NÃO existe na API):
#   gemini-1.5-flash-8b    ← recomendado p/ respostas curtas e diretas (gincana)
#   gemini-1.5-flash
#   gemini-2.0-flash
#   gemini-2.5-flash       ← pode truncar resposta curta (tokens de "thinking")
GEMINI_MODEL=gemini-1.5-flash-8b

# ----- Banco de dados (PostgreSQL) -----
# String de conexão. Para usar o docker-compose deste projeto, basta deixar como
# está. Em produção, aponte para o seu Postgres gerenciado.
DATABASE_URL=postgres://wppbot:wppbot@localhost:5432/wppbot

# Variáveis usadas pelo docker-compose.yml (não pelo app):
POSTGRES_USER=wppbot
POSTGRES_PASSWORD=wppbot
POSTGRES_DB=wppbot
POSTGRES_PORT=5432

# ----- Grupos / líderes -----
# Os líderes agora são configurados POR GRUPO via dashboard web (persistido no
# Postgres). O .env não precisa mais listar LEADER_NUMBERS.
#
# IDs dos grupos onde o bot vai atuar (separados por vírgula).
# Deixe em branco para responder em QUALQUER grupo em que o líder esteja.
# Exemplo de ID de grupo: 120363025123456789@g.us
ALLOWED_GROUPS=

# ----- Comportamento -----
# Tempo mínimo (ms) entre respostas a um MESMO líder (evita flood/ban)
COOLDOWN_MS=1500

# Tempo (segundos) que respostas ficam em cache.
# Cache é persistido em Postgres, então sobrevive a restarts.
# 604800 = 7 dias (gabaritos de gincana não mudam).
CACHE_TTL_SECONDS=604800

# Máximo de tentativas ao chamar a IA antes de cair no fallback.
# Só faz retry em 5xx/429/rede; 4xx aborta imediatamente.
AI_MAX_RETRIES=2

# Tempo limite (ms) para cada tentativa de chamada à IA
AI_TIMEOUT_MS=5000

# Tamanho máximo (caracteres) da pergunta aceita
MAX_QUESTION_LENGTH=300

# Classificação com IA: analisa buffer das últimas N mensagens do grupo
# antes de responder (evita conversa/organização). Use false para desativar.
CLASSIFY_WITH_AI=true
CHAT_BUFFER_SIZE=10

# Resposta usada quando todas as tentativas de IA falham
FALLBACK_ANSWER=Não consegui responder agora.

# ----- Sessão / Cliente -----
# Nome da pasta da sessão (dentro de WWEBJS_AUTH_PATH ou .wwebjs_auth)
SESSION_NAME=wppbot-session

# Caminho absoluto da pasta de auth (Docker/EasyPanel: /app/.wwebjs_auth)
# WWEBJS_AUTH_PATH=/app/.wwebjs_auth

# Caminho do executável Chrome/Chromium (opcional; deixe vazio para usar o do Puppeteer)
# Em WSL/Linux costuma ser: /usr/bin/google-chrome  ou  /usr/bin/chromium
CHROME_PATH=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ----- Dashboard Web -----
# Liga/desliga a dashboard web (http://localhost:WEB_PORT)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Token opcional. Se definido, a UI deve ser acessada com ?token=XYZ na URL.
WEB_TOKEN=

# ----- HTTPS com Caddy (opcional, perfil "https" do docker-compose) -----
# Domínio que aponta para a VPS (registro A/AAAA já configurado).
DASHBOARD_DOMAIN=bot.seudominio.com
# E-mail usado pelo Let's Encrypt (avisos de expiração, etc.)
DASHBOARD_EMAIL=admin@example.com
