# ============================================================
#  CONFIGURAÇÃO DO BOT DE GINCANA WHATSAPP
# ============================================================
# Copie este arquivo para `.env` e preencha com seus dados:
#   cp .env.example .env
# ============================================================

# ----- Provedor de IA -----
# Escolha "openai" ou "gemini"
AI_PROVIDER=openai

# Chave da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Chave do Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# ----- Líderes autorizados -----
# Números completos com DDI+DDD, separados por vírgula. Ex: 5511999999999,5521988888888
# (Você descobre o número certo olhando o log do bot quando ele recebe mensagens.)
LEADER_NUMBERS=5511999999999

# IDs dos grupos onde o bot vai atuar (separados por vírgula).
# Deixe em branco para responder em QUALQUER grupo em que o líder esteja.
# Exemplo de ID de grupo: 120363025123456789@g.us
ALLOWED_GROUPS=

# ----- Comportamento -----
# Tempo mínimo (ms) entre respostas a um MESMO líder (evita flood/ban)
COOLDOWN_MS=1500

# Tempo (segundos) que respostas ficam em cache
CACHE_TTL_SECONDS=3600

# Máximo de tentativas ao chamar a IA antes de cair no fallback
AI_MAX_RETRIES=2

# Tempo limite (ms) para cada tentativa de chamada à IA
AI_TIMEOUT_MS=8000

# Tamanho máximo (caracteres) da pergunta aceita
MAX_QUESTION_LENGTH=500

# Resposta usada quando todas as tentativas de IA falham
FALLBACK_ANSWER=Não consegui responder agora.

# ----- Sessão / Cliente -----
# Nome da pasta da sessão (dentro de .wwebjs_auth)
SESSION_NAME=wppbot-session

# Caminho do executável Chrome/Chromium (opcional; deixe vazio para usar o do Puppeteer)
# Em WSL/Linux costuma ser: /usr/bin/google-chrome  ou  /usr/bin/chromium
CHROME_PATH=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ----- Dashboard Web -----
# Liga/desliga a dashboard web (http://localhost:WEB_PORT)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Token opcional. Se definido, a UI deve ser acessada com ?token=XYZ na URL.
WEB_TOKEN=
