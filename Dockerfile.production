# syntax=docker/dockerfile:1.7
# ============================================================
#  Dockerfile.production
#  Imagem otimizada para rodar o wppbot em uma VPS.
#
#  Build:
#    docker build -f Dockerfile.production -t wppbot:prod .
#
#  Run (standalone):
#    docker run -d --name wppbot \
#      --env-file .env \
#      -p 3000:3000 \
#      -v wppbot-auth:/app/.wwebjs_auth \
#      -v wppbot-cache:/app/.wwebjs_cache \
#      -v wppbot-logs:/app/logs \
#      wppbot:prod
#
#  Run (com docker compose + Postgres):
#    docker compose --profile production up -d --build
# ============================================================

# Dashboard React: usamos os artefatos já buildados em src/web/public/
# (commitados no repo). Rode `npm run dashboard:build` antes do deploy.
# Build dentro do Docker costuma falhar no EasyPanel (memória / Node+Vite).


# ─── Stage 1: dependências de produção ────────────────────────
FROM node:20-bookworm-slim AS deps

WORKDIR /app

# Evita que o puppeteer baixe o próprio Chromium — vamos usar o do sistema.
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --no-audit --no-fund


# ─── Stage 2: runtime ─────────────────────────────────────────
FROM node:20-bookworm-slim AS runtime

# Instala o Chromium e libs nativas que o whatsapp-web.js/Puppeteer exigem.
# `tini` cuida do PID 1 para sinais (graceful shutdown). `dumb-init` seria
# alternativa equivalente.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        ca-certificates \
        fonts-liberation \
        fonts-noto-color-emoji \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxss1 \
        tini \
        wget \
        gosu \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=3000

WORKDIR /app

# Copia node_modules da stage anterior e o código da aplicação.
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src
COPY ecosystem.config.cjs ./
COPY src/web/public ./src/web/public
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /app/.wwebjs_auth /app/.wwebjs_cache /app/logs \
    && chown -R node:node /app

EXPOSE 3000

# Healthcheck simples bate no /api/state. Se a dashboard estiver desabilitada
# (WEB_ENABLED=false), troque por algo equivalente (ou remova).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q --spider --timeout=3 "http://127.0.0.1:${WEB_PORT}/api/state" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "src/index.js"]
