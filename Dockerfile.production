# syntax=docker/dockerfile:1.7
# ============================================================
#  Dockerfile.production
#  Imagem otimizada para rodar o wppbot em uma VPS.
#
#  Build (inclui dashboard React → src/web/public):
#    docker build -f Dockerfile.production -t wppbot:prod .
#
#  Run (com docker compose + Postgres):
#    docker compose --profile production up -d --build
# ============================================================

# ─── Stage: dashboard (Vite → src/web/public) ─────────────────
FROM node:20-bookworm-slim AS dashboard

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./dashboard/

RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefix dashboard --no-audit --no-fund

COPY dashboard ./dashboard/

RUN npm run build --prefix dashboard


# ─── Stage: dependências de produção do bot ────────────────────
FROM node:20-bookworm-slim AS deps

WORKDIR /app

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --no-audit --no-fund


# ─── Stage: runtime ───────────────────────────────────────────
FROM node:20-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        ca-certificates \
        fonts-liberation \
        fonts-noto-color-emoji \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxss1 \
        tini \
        wget \
        gosu \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    CHROME_PATH=/usr/bin/chromium \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=3000

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY src ./src
COPY --from=dashboard /app/src/web/public ./src/web/public
COPY ecosystem.config.cjs ./
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /app/.wwebjs_auth /app/.wwebjs_cache /app/logs \
    && chown -R node:node /app

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q --spider --timeout=3 "http://127.0.0.1:${WEB_PORT}/api/state" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "src/index.js"]
